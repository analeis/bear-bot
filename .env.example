# bear-bot configuration
# Copy to .env and fill in what you need. Every platform is optional:
# set DISCORD_TOKEN and/or FLUXER_TOKEN.

# --- Discord -----------------------------------------------------------------
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Optional: the application id. When empty it is looked up with the token.
DISCORD_APPLICATION_ID=
# Optional: register commands to a single guild for fast local testing.
# DISCORD_GUILD_ID=

# --- Fluxer ------------------------------------------------------------------
# Bot token from the Fluxer developer portal.
FLUXER_TOKEN=
# Prefix used for Fluxer prefix commands (Fluxer has no slash commands yet).
FLUXER_PREFIX=!
# Optional: point the bot at a self-hosted Fluxer instance.
# FLUXER_API_URL=https://fluxer.example.com

# --- Storage -----------------------------------------------------------------
# SQLite database file. The directory is created automatically.
DATABASE_PATH=./data/bear-bot.db

# --- GIFs --------------------------------------------------------------------
# Optional API keys. Without any key bear-bot falls back to a keyless
# Giphy search.
# KLIPY_APP_KEY=
# TENOR_API_KEY=
# GIPHY_API_KEY=
# Stable customer id passed to the GIF providers.
GIF_CUSTOMER_ID=bear-bot

# --- Tuning ------------------------------------------------------------------
# Stamina points and how fast they come back.
STAMINA_MAX=100
STAMINA_REGEN_INTERVAL_MS=60000
# debug | info | warn | error
LOG_LEVEL=info
